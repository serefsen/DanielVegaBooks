<section class="hero">
  <div class="hero-inner container">
    <div class="hero-text">
      <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Daniel Vega - anxiety workbooks for teens</h1><img src="/image/logo.png" alt="Daniel Vega" class="hero-logo" />
      <p class="hero-sub">Honest, calming books about anxiety — for teens figuring out how to breathe through it all.</p>
      <div class="hero-cta">
        <a href="/books/" class="btn btn-primary">Explore the Books</a>
        <a href="/about/" class="btn btn-ghost">About Me</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="avatar-wrap">
        <div class="speech"><span class="wave">&#128075;</span> Hi, I'm Daniel</div>
        <div class="avatar-frame" id="heroAvatar">
          <img src="/image/DanielVegaPeek.webp" alt="Illustrated portrait of Daniel Vega" class="avatar" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { display: flex; align-items: center; min-height: 78vh; padding: 40px 0 60px; }
  .hero-inner { display: flex; align-items: center; gap: 48px; width: 100%; }
  .hero-text { flex: 1.2; }
  .hero-art { flex: 1; display: flex; justify-content: center; animation: fadein 1s ease both; }

  .hero-logo { height: 90px; width: auto; display: block; margin-bottom: 24px; }
  .hero-sub { font-size: 19px; line-height: 1.6; color: var(--ink-soft); max-width: 430px; margin: 0 0 30px; }

  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 600; padding: 14px 26px; border-radius: 12px;
    transition: transform .18s ease, background .18s ease, border-color .18s ease, color .18s ease;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--border); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

  .avatar-wrap { position: relative; }
  .avatar-frame {
    width: 320px; height: 320px; border-radius: 50%;
    background: var(--bg-peach); overflow: hidden;
    box-shadow: 0 18px 40px rgba(80, 60, 40, .14);
    animation: breathe 6s ease-in-out infinite;
  }
  .avatar { width: 100%; height: 100%; object-fit: cover; object-position: center 18%; display: block; }

  .speech {
    position: absolute; top: -30px; right: -26px; z-index: 3;
    background: var(--badge); color: var(--badge-ink);
    padding: 10px 18px; border-radius: 18px;
    font-size: 15px; font-weight: 600; white-space: nowrap;
    box-shadow: 0 10px 24px rgba(120, 80, 40, .18);
    animation: pop .5s ease .6s both;
  }
  .speech::after {
    content: ""; position: absolute; left: 24px; bottom: -6px;
    width: 14px; height: 14px; background: var(--badge);
    transform: rotate(45deg);
  }
  .wave { display: inline-block; transform-origin: 70% 70%; animation: wave 2.6s ease-in-out infinite; }

  .hero-text > * { animation: rise .7s ease both; }
  .hero-text > *:nth-child(2) { animation-delay: .1s; }
  .hero-text > *:nth-child(3) { animation-delay: .2s; }

  @keyframes wave {
    0%, 65%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); } 20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); } 40% { transform: rotate(-4deg); } 50% { transform: rotate(10deg); }
  }
  @keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.92); } to { opacity: 1; transform: translateY(0) scale(1); } }

  @media (max-width: 820px) {
    .hero { min-height: auto; padding: 20px 0 48px; }
    .hero-inner { flex-direction: column-reverse; text-align: center; gap: 30px; }
    .hero-text { flex: none; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-cta { justify-content: center; }
    .hero-logo { height: 66px; margin-bottom: 18px; }
    .avatar-frame { width: 230px; height: 230px; }
    .speech { top: -6px; right: 0; }
  }
</style>







