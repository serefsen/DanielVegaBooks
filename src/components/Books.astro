---
import { books } from "../data/books.js";
---
<section style="padding:74px 0 86px">
  <div class="container">
    <h2 style="font-family:'"'"'Fraunces'"'"',serif;font-size:32px;text-align:center;margin:0 0 10px;color:#2E2521">The Response Training Series</h2>
    <p style="text-align:center;color:#7A6E66;font-size:17px;line-height:1.6;max-width:560px;margin:0 auto">Short, honest workbooks for teens who can't stand workbooks — a trilogy, one feeling at a time.</p>
    <div style="display:flex;justify-content:center;align-items:flex-start;flex-wrap:wrap;gap:36px 40px;max-width:760px;margin:54px auto 0">
      {books.map((book) => (
        <article style="width:200px;text-align:center">
          <a href="/books" style="display:block;width:200px;margin:0 auto 18px;text-decoration:none">
            {book.cover
              ? <img class="bkcov" src={book.cover} alt={book.title + " cover"} style="display:block;width:200px;height:auto" />
              : <div class="bkcov" style="width:200px;aspect-ratio:4/5;border-radius:10px;background:linear-gradient(155deg,#d6c9b7,#b6a999);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#463d31;box-sizing:border-box;box-shadow:0 14px 28px -10px rgba(74,52,28,.34)"><span style="font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;opacity:.85">Book 3</span><span style="font-family:'"'"'Fraunces'"'"',serif;font-size:26px;line-height:1.05;color:#3a3228;margin-top:4px">Coming<br/>Soon</span></div>}
          </a>
          <span style="font-size:11px;font-weight:700;color:#5C6F9C;text-transform:uppercase;letter-spacing:.5px;display:block">{book.series}</span>
          <h3 style="font-family:'"'"'Fraunces'"'"',serif;font-size:18px;margin:7px 0 5px;line-height:1.2;color:#2E2521">{book.title}</h3>
          <p style="font-size:13px;color:#7A6E66;line-height:1.45;margin:0 0 13px">{book.subtitle}</p>
          {book.published
            ? <a href={book.amazon} target="_blank" rel="noopener" aria-label={"Buy " + book.title + " on Amazon"} style="display:inline-flex;align-items:center;gap:8px;text-decoration:none"><span style="font-size:13.5px;font-weight:700;color:#2E2521">Buy from</span><img src="/image/0148.png" alt="Amazon" style="height:38px;width:auto;display:block;border-radius:6px;box-shadow:0 4px 14px rgba(0,0,0,.16)" /></a>
            : <span style="display:inline-block;background:#FAD9B0;color:#6B4E2E;font-size:12.5px;font-weight:700;padding:6px 14px;border-radius:999px">Coming soon</span>}
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .bkcov { transition: transform .4s cubic-bezier(.34,1.5,.5,1); }
  a:hover > .bkcov { transform: translateY(-9px) scale(1.035); animation: bkwig .55s ease; }
  @keyframes bkwig { 0%,100%{rotate:0deg} 22%{rotate:-4deg} 52%{rotate:3deg} 78%{rotate:-1.5deg} }
</style>




