---
const links = [
  { label: "Books", href: "/books/" },
  { label: "About", href: "/about/" },
  { label: "Blog", href: "/blog/" },
  { label: "Contact", href: "/contact/" },
];
---
<header class="navwrap">
  <nav class="nav">
    <a href="/" class="brand" aria-label="Daniel Vega - home">
      <img src="/image/logo-white.png" alt="Daniel Vega" class="brand-logo" />
    </a>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="links" id="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/newsletter/" class="cta">Newsletter</a>
    </div>
  </nav>
</header>

<style>
  .navwrap { position: sticky; top: 0; z-index: 50; padding: 16px 24px; }
  .nav {
    max-width: var(--maxw); margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    background: var(--nav); color: var(--nav-ink);
    border-radius: 22px; padding: 13px 18px 13px 22px;
  }
  .brand { display: flex; align-items: center; }
  .brand-logo { height: 34px; width: auto; display: block; }
  .links { display: flex; align-items: center; gap: 24px; }
  .links a { font-size: 14.5px; color: #CFC3B8; transition: color .2s ease; }
  .links a:hover { color: var(--nav-ink); }
  .cta { background: #FBF1E6; color: var(--nav) !important; padding: 9px 18px; border-radius: 999px; font-weight: 600; }
  .cta:hover { background: #fff; }
  .burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
  .burger span { width: 22px; height: 2px; background: var(--nav-ink); border-radius: 2px; }
  @media (max-width: 760px) {
    .burger { display: flex; }
    .brand-logo { height: 28px; }
    .links {
      position: absolute; top: 74px; left: 24px; right: 24px;
      flex-direction: column; align-items: flex-start; gap: 18px;
      background: var(--nav); border-radius: 18px; padding: 22px; display: none;
    }
    .links.open { display: flex; }
    .links a { font-size: 16px; }
  }
</style>

<script>
  const b = document.getElementById("burger");
  const l = document.getElementById("links");
  b?.addEventListener("click", () => {
    const open = l?.classList.toggle("open");
    b.setAttribute("aria-expanded", String(!!open));
  });
</script>

