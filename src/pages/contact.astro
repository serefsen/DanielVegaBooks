---
import Layout from "../layouts/Layout.astro";

const moods = [
  { e: "\u{1F623}", label: "Rough day", reply: "Sending you a little calm." },
  { e: "\u{1F610}", label: "Kind of meh", reply: "Hope today gets gentler." },
  { e: "\u{1F642}", label: "Doing okay", reply: "Glad you're holding steady." },
  { e: "\u{1F60C}", label: "Pretty good", reply: "Love that — keep it going." },
  { e: "\u{2728}", label: "Great", reply: "Yes! Soak it up." },
];
---
<Layout title="Contact — Daniel Vega" description="Say hello to Daniel Vega — questions, thoughts, or just to say a chapter hit home.">
  <section class="contact">
    <div class="container">
      <header class="ct-head reveal">
        <span class="ct-eyebrow">Say hello</span>
        <h1>Drop me a line.</h1>
        <p>Questions, thoughts, or just want to tell me a chapter hit home? There's no wrong way to say hi — I read every message.</p>
      </header>

      <div class="ct-grid">
        <aside class="ct-side reveal">
          <div class="ct-side-block">
            <h2>What happens next</h2>
            <p>I'm one person, writing these between everything else — so replies can take a few days. But they always come.</p>
          </div>
          <div class="ct-side-block">
            <h2>Prefer email?</h2>
            <a href="mailto:hello@danielvegabooks.com" class="ct-email">hello@danielvegabooks.com</a>
          </div>
        </aside>

        <div class="ct-card reveal">
          <div class="ct-mood">
            <span class="ct-mood-q">How's today treating you?</span>
            <div class="ct-mood-row">
              {moods.map((m) => (
                <button type="button" class="ct-mood-btn" data-reply={m.reply} aria-label={m.label}>{m.e}</button>
              ))}
            </div>
            <span class="ct-mood-reply" id="ctMoodReply"></span>
          </div>

          <form class="ct-form" id="ctForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate><input type="hidden" name="form-name" value="contact" /><p hidden><label>Leave this empty: <input name="bot-field" /></label></p>
            <div class="ct-field">
              <label class="ct-label" for="ctName">Your name</label>
              <input type="text" id="ctName" name="name" class="ct-input" placeholder="What should I call you?" />
            </div>
            <div class="ct-field">
              <label class="ct-label" for="ctEmail">Email</label>
              <input type="email" id="ctEmail" name="email" class="ct-input" placeholder="you@email.com" />
            </div>
            <div class="ct-field">
              <label class="ct-label" for="ctMsg">Message</label>
              <textarea id="ctMsg" name="message" class="ct-textarea" placeholder="Say as much or as little as you like."></textarea>
            </div>
            <button type="submit" class="ct-send" id="ctSend">
              <span class="ct-send-text">Send message</span>
              <span class="ct-plane">&#9992;&#65038;</span>
            </button>
          </form>

          <div class="ct-sent" id="ctSent" hidden>
            <span class="ct-sent-plane">&#9992;&#65038;</span>
            <p>On its way. Thanks for reaching out — I read every message and I'll get back to you soon. <span>&#129293;</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact { padding: 56px 0 90px; }
  .ct-head { text-align: center; max-width: 600px; margin: 0 auto 50px; }
  .ct-eyebrow { font-size: 13px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .6px; }
  .ct-head h1 { font-size: 40px; margin: 12px 0 14px; }
  .ct-head p { font-size: 18px; line-height: 1.6; color: var(--ink-soft); margin: 0; }

  .ct-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 44px; align-items: start; }

  .ct-side { padding-top: 8px; }
  .ct-side-block { margin-bottom: 28px; }
  .ct-side-block h2 { font-size: 16px; margin: 0 0 8px; }
  .ct-side-block p { font-size: 15.5px; line-height: 1.65; color: var(--ink-soft); margin: 0; }
  .ct-email { font-size: 15.5px; font-weight: 700; color: var(--accent); border-bottom: 2px solid transparent; transition: border-color .2s ease; }
  .ct-email:hover { border-color: var(--accent); }

  .ct-card { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 32px 30px; box-shadow: 0 20px 50px rgba(80,60,40,.08); }

  .ct-mood { margin-bottom: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--border); }
  .ct-mood-q { display: block; font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 12px; }
  .ct-mood-row { display: flex; gap: 9px; flex-wrap: wrap; }
  .ct-mood-btn {
    font-size: 26px; line-height: 1; background: var(--bg); border: 1.5px solid var(--border);
    border-radius: 12px; padding: 8px 11px; cursor: pointer;
    transition: transform .2s cubic-bezier(.34,1.6,.5,1), border-color .2s ease, background .2s ease;
  }
  .ct-mood-btn:hover { transform: translateY(-2px); border-color: var(--accent); }
  .ct-mood-btn.selected { border-color: var(--accent); background: var(--badge); transform: scale(1.12); }
  .ct-mood-reply { display: block; min-height: 20px; margin-top: 12px; font-size: 14px; font-weight: 600; color: var(--accent); opacity: 0; }
  .ct-mood-reply.show { animation: fadeup .4s ease forwards; }

  .ct-field { margin-bottom: 14px; }
  .ct-label { display: block; font-size: 13px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .ct-input, .ct-textarea {
    width: 100%; box-sizing: border-box; font-family: var(--font-sans); font-size: 15px; color: var(--ink);
    background: var(--bg); border: 1.5px solid var(--border); border-radius: 12px; padding: 12px 14px;
    outline: none; transition: border-color .2s ease, box-shadow .2s ease;
  }
  .ct-input::placeholder, .ct-textarea::placeholder { color: #B7A99C; }
  .ct-input:focus, .ct-textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(92,111,156,.16); }
  .ct-textarea { resize: vertical; min-height: 120px; }

  .ct-send {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 6px;
    font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: #fff; cursor: pointer;
    background: var(--accent); border: none; border-radius: 12px; padding: 13px 24px;
    transition: transform .18s ease, background .18s ease;
  }
  .ct-send:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .ct-plane { display: inline-block; transition: transform .6s ease, opacity .5s ease; }
  .ct-send.flying .ct-plane { transform: translate(46px, -46px) rotate(18deg); opacity: 0; }
  .ct-send.flying .ct-send-text { opacity: .45; transition: opacity .3s ease; }

  .ct-sent { text-align: center; padding: 12px 0; animation: fadeup .5s ease; }
  .ct-sent[hidden] { display: none; }
  .ct-sent-plane { font-size: 42px; display: inline-block; color: var(--accent); animation: planebob 2.2s ease-in-out infinite; }
  .ct-sent p { font-size: 16.5px; line-height: 1.6; color: var(--ink); margin: 16px auto 0; max-width: 340px; }

  .reveal { opacity: 0; transform: translateY(26px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.revealed { opacity: 1; transform: none; }

  @keyframes fadeup { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes planebob { 0%, 100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-8px) rotate(-2deg); } }

  @media (max-width: 820px) {
    .ct-head h1 { font-size: 31px; }
    .ct-grid { grid-template-columns: 1fr; gap: 30px; }
  }
</style>

<script>
  const moodReply = document.getElementById("ctMoodReply");
  document.querySelectorAll(".ct-mood-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".ct-mood-btn").forEach((b) => b.classList.remove("selected"));
      btn.classList.add("selected");
      moodReply.textContent = btn.getAttribute("data-reply") || "";
      moodReply.classList.remove("show");
      void moodReply.offsetWidth;
      moodReply.classList.add("show");
    });
  });

  const form = document.getElementById("ctForm");
  const sent = document.getElementById("ctSent");
  const sendBtn = document.getElementById("ctSend");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = document.getElementById("ctName");
    const email = document.getElementById("ctEmail");
    const msg = document.getElementById("ctMsg");
    let ok = true;
    [name, email, msg].forEach((f) => { f.style.borderColor = ""; });
    if (!name.value.trim()) { name.style.borderColor = "#D98B53"; ok = false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) { email.style.borderColor = "#D98B53"; ok = false; }
    if (!msg.value.trim()) { msg.style.borderColor = "#D98B53"; ok = false; }
    if (!ok) return;
    fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: new URLSearchParams(new FormData(form)).toString() }).catch(function(){}); sendBtn.classList.add("flying");
    setTimeout(() => { form.hidden = true; sent.hidden = false; }, 650);
  });
</script>

