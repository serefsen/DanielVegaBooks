---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/posts.js";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const sorted = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
const idx = sorted.findIndex((p) => p.slug === post.slug);
const next = sorted[idx + 1];
function fmt(d) {
  return new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
const postUrl = "https://danielvegabooks.com/blog/" + post.slug + "/";
const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.date,
  "dateModified": post.date,
  "url": postUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
  "author": { "@type": "Person", "name": "Daniel Vega" },
  "publisher": { "@type": "Person", "name": "Daniel Vega" },
  "image": "https://danielvegabooks.com/image/og-image.png",
  "keywords": post.tag,
};
---
<Layout title={post.title + " — Daniel Vega"} description={post.excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  <div class="bl-progress" id="blProgress"></div>
  <article class="post">
    <div class="container post-inner">
      <a href="/blog/" class="post-back"><span class="ba">&larr;</span> All posts</a>
      <span class="post-tag">{post.tag}</span>
      <h1 class="post-title">{post.title}</h1>
      <p class="post-meta">{fmt(post.date)} · {post.readingTime}</p>
      <div class="post-body">
        {post.body.map((para) => <p set:html={para} />)}
      </div>

      <div class="tk-card">
        <h2 class="tk-title">Get the free toolkit</h2>
        <p class="tk-sub">One page, six tools your teen can use the moment anxiety spikes. Sent straight to your inbox.</p>
        <form class="tk-form" id="tkForm" action="https://assets.mailerlite.com/jsonp/2468129/forms/191166300278490999/subscribe" method="post" novalidate>
          <input type="email" id="tkEmail" name="fields[email]" class="tk-input" placeholder="you@email.com" aria-label="Email address" autocomplete="email" required />
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />
          <button type="submit" class="tk-btn">Send me the toolkit →</button>
        </form>
        <p class="tk-fine" id="tkFine">No spam, ever — just the toolkit and the occasional good word.</p>
        <p class="tk-thanks" id="tkThanks" hidden></p>
      </div>

      <div class="post-foot">
        <a href="/blog/" class="post-back"><span class="ba">&larr;</span> Back to all posts</a>
        {next && (
          <a href={"/blog/" + next.slug + "/"} class="post-next">
            <span class="pn-label">Next read</span>
            <span class="pn-title">{next.title} <span class="pn-arrow">&rarr;</span></span>
          </a>
        )}
      </div>
    </div>
  </article>
</Layout>

<style>
  .bl-progress { position: fixed; top: 0; left: 0; height: 4px; width: 0%; background: var(--accent); z-index: 60; }

  .post { padding: 40px 0 80px; }
  .post-inner { max-width: 680px; margin: 0 auto; }
  .post-back { font-size: 14.5px; font-weight: 600; color: var(--accent); display: inline-flex; align-items: center; gap: 7px; }
  .post-back .ba { transition: transform .2s ease; }
  .post-back:hover .ba { transform: translateX(-4px); }

  .post-tag { display: block; font-size: 12.5px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .5px; margin-top: 30px; }
  .post-title { font-size: 38px; line-height: 1.18; margin: 12px 0 12px; }
  .post-meta { font-size: 14px; color: var(--ink-soft); font-weight: 600; margin: 0 0 32px; padding-bottom: 28px; border-bottom: 1px solid var(--border); }

  .post-body p { font-size: 18px; line-height: 1.85; color: var(--ink); margin: 0 0 24px; }
  .post-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .post-body a:hover { color: var(--accent-dark); }

  /* Free toolkit box (inline lead magnet) */
  .tk-card { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 32px 30px; box-shadow: 0 18px 44px rgba(80,60,40,.10); margin-top: 48px; }
  .tk-title { font-size: 24px; margin: 0 0 6px; }
  .tk-sub { font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 20px; }
  .tk-form { display: flex; flex-direction: column; gap: 10px; }
  .tk-input { font-family: var(--font-sans); font-size: 15px; color: var(--ink); background: var(--bg); border: 1.5px solid var(--border); border-radius: 12px; padding: 13px 16px; outline: none; transition: border-color .2s ease, box-shadow .2s ease; }
  .tk-input::placeholder { color: #B7A99C; }
  .tk-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(92,111,156,.16); }
  .tk-btn { font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: #fff; cursor: pointer; background: var(--accent); border: none; border-radius: 12px; padding: 13px 22px; transition: transform .18s ease, background .18s ease; }
  .tk-btn:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .tk-fine { font-size: 13.5px; color: var(--ink-soft); margin: 14px 0 0; }
  .tk-fine[hidden], .tk-thanks[hidden] { display: none; }
  .tk-thanks { font-family: var(--font-serif); font-size: 20px; color: var(--ink); margin: 14px 0 0; animation: tkpop .4s cubic-bezier(.34,1.56,.64,1); }
  @keyframes tkpop { from { opacity: 0; transform: scale(.9); } to { opacity: 1; transform: scale(1); } }

  .post-foot { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 24px; }
  .post-next { background: var(--bg-peach); border-radius: 16px; padding: 20px 24px; transition: transform .2s ease, box-shadow .2s ease; }
  .post-next:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(80,60,40,.12); }
  .pn-label { display: block; font-size: 12px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 5px; }
  .pn-title { font-size: 18px; font-weight: 700; color: var(--ink); display: inline-flex; align-items: center; gap: 7px; }
  .pn-arrow { transition: transform .2s ease; }
  .post-next:hover .pn-arrow { transform: translateX(4px); }

  @media (max-width: 600px) { .post-title { font-size: 29px; } .post-body p { font-size: 16.5px; } }
</style>

<script>
  const bar = document.getElementById("blProgress");
  function update() {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
    if (bar) bar.style.width = pct + "%";
  }
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();

  // Free toolkit form -> MailerLite
  const tkForm = document.getElementById("tkForm") as HTMLFormElement | null;
  const tkEmail = document.getElementById("tkEmail") as HTMLInputElement;
  const tkFine = document.getElementById("tkFine");
  const tkThanks = document.getElementById("tkThanks");
  tkForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const val = tkEmail.value.trim();
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
    if (!ok) { tkEmail.focus(); tkEmail.style.borderColor = "#D98B53"; return; }
    const body = new URLSearchParams();
    body.append("fields[email]", val);
    body.append("ml-submit", "1");
    body.append("anticsrf", "true");
    fetch(tkForm.action, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: body.toString(),
    }).catch(function(){});
    if (tkForm) tkForm.hidden = true;
    if (tkFine) tkFine.hidden = true;
    if (tkThanks) { tkThanks.hidden = false; tkThanks.textContent = "Check your inbox \u{1F4E9} Your toolkit is on its way."; }
  });
</script>
