---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found — Daniel Vega" description="This page doesn't exist — but the books and the blog do.">
  <section class="nf">
    <div class="container nf-inner">
      <span class="nf-eyebrow">404</span>
      <h1>This page didn't make it here.</h1>
      <p>The link's broken, or the page moved on without it. Either way, nothing's wrong with you for landing here — let's just get you somewhere real.</p>
      <div class="nf-cta">
        <a href="/books/" class="nf-btn nf-btn-primary">Explore the Books</a>
        <a href="/blog/" class="nf-btn nf-btn-ghost">Read the Blog</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf { display: flex; align-items: center; min-height: 62vh; padding: 40px 0 60px; }
  .nf-inner { max-width: 560px; margin: 0 auto; text-align: center; }
  .nf-eyebrow {
    display: inline-block; font-family: var(--font-serif); font-size: 15px; font-weight: 600;
    color: var(--badge-ink); background: var(--badge); padding: 6px 16px; border-radius: 999px;
    letter-spacing: .5px; margin-bottom: 22px;
  }
  .nf h1 { font-size: 34px; line-height: 1.2; margin: 0 0 16px; }
  .nf p { font-size: 17px; line-height: 1.65; color: var(--ink-soft); margin: 0 0 32px; }

  .nf-cta { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .nf-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 600; padding: 14px 26px; border-radius: 12px;
    transition: transform .18s ease, background .18s ease, border-color .18s ease, color .18s ease;
  }
  .nf-btn-primary { background: var(--accent); color: #fff; }
  .nf-btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); }
  .nf-btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--border); }
  .nf-btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

  @media (max-width: 600px) { .nf h1 { font-size: 27px; } }
</style>
